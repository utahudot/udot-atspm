{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATSPM documentation container map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourcePaths",
    "containers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "sourcePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "containers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "slug",
          "sections"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
          },
          "sections": {
            "type": "array",
            "description": "Ordered configuration section names. Use SectionName:NestedPath for named or nested configuration bindings.",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
